digraph FINAL_PIPELINE {
  // 最终目标数据管线（Nav2 式分层）——super_super_apm
  graph [rankdir=LR, compound=true, newrank=true, splines=true,
         nodesep=0.22, ranksep=0.45, fontname="Microsoft YaHei", fontsize=22,
         labelloc=t, label="super_super_apm 最终目标数据管线（Nav2 式薄层重做后的完整链路）\n黑色=现有保留  蓝色=本轮设计新增/替换  绿色=记录与评测  红色=安全/监督"];
  node  [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#333333",
         fontname="Microsoft YaHei", fontsize=9, margin="0.07,0.035"];
  edge  [color="#444444", arrowsize=0.6, fontname="Microsoft YaHei", fontsize=7.5];

  // ---------------- 1. 仿真与传感器 ----------------
  subgraph cluster_sim {
    label="① 仿真与传感器（只用于 SITL 验证）"; color="#6a8f8f"; style="rounded"; fontsize=14;
    sitl  [label="ArduPilot SITL\nArduCopter 4.7.1\n1 kg / 250 mm 机体模型"];
    lidarsim [label="LiDAR + IMU 仿真\nscan ~7 Hz / IMU 200 Hz\n(raycast 由 SITL 位姿驱动)", fill="#eef5ff"];
    tapd  [label="真值 tap（1 kHz）\n唯一评测真值", shape=note, fillcolor="#e8f5e9"];
  }

  // ---------------- 2. 定位 ----------------
  subgraph cluster_lio {
    label="② 定位"; color="#6a8f8f"; style="rounded"; fontsize=14;
    lio [label="Super-LIO\nLiDAR-惯性里程计\nL 系 pose / vel（~50 Hz）\nscan→地图配准 + IMU 预积分"];
  }

  // ---------------- 3. 地图 ----------------
  subgraph cluster_map {
    label="③ 占据地图"; color="#6a8f8f"; style="rounded"; fontsize=14;
    rogmap [label="ROG-Map（栅格 + 膨胀）\nOCCUPIED / KNOWN_FREE\n3×3 m 角点 keepout"];
  }

  // ---------------- 4. 目标 / 规划 / 跟随（新薄层） ----------------
  subgraph cluster_stack {
    label="④ 目标·规划·跟随（Nav2 式分层；薄层重做区）"; color="#1565c0"; style="rounded"; fontsize=14; penwidth=2;
    route [label="Route Manager（新）\n路线 poses + 弧长进度\n中间点 pass-by 记账 0.5–0.7 m（不重规划）\nGoalChecker 仅终点 xy≤0.3–0.5 m\nProgressChecker 10 s / 0.5 m → Recovery", fillcolor="#e3f2fd"];
    super [label="SUPER planner\n多航点 / through-poses\nA* + MINCO 走廊优化\n按固定速率重规划『剩余路径』\n(1–3 Hz；有效则不重规划)", fillcolor="#e3f2fd"];
    smooth [label="Path smoother（新）\n角点圆滑（S-G / Simple）\n保持走廊与障碍约束", fillcolor="#e3f2fd"];
    follow [label="Follower（新，RPP 式）\n前视 L=clamp(k·v,Lmin,Lmax)\n曲率限速 v≤sqrt(a_lat·R)\n终点减速 + 速度下限 v_floor", fillcolor="#e3f2fd"];
    vsmooth [label="Velocity smoother（新）\n唯一一层 max_v / max_a / max_jerk 运动学壳", fillcolor="#e3f2fd"];
    shaper [label="Command shaper\nPVA 100 Hz；L→W 换算\nz 基准补偿 + stale/hold 后备", fillcolor="#e3f2fd"];
  }

  // ---------------- 5. 飞控 / 桥 ----------------
  subgraph cluster_fcu {
    label="⑤ 桥 + 飞控"; color="#6a8f8f"; style="rounded"; fontsize=14;
    navgate [label="NAV gate\nodom age / quality / reset\n(不达标 → 拒绝喂 EKF)"];
    brg  [label="bridge（MAVLink）\n#331 ODOMETRY 48 Hz（外部导航）\n#84 SET_POSITION_TARGET 50 Hz（PVA）\nclass-76：arm / takeoff / mode / LAND"];
    ekf  [label="FCU EKF\nIMU + 外部导航融合\n(EKF2 ext-nav)"];
    ctl  [label="FCU 位置/速度环 + 姿态环\nPSC_NE_* / 电机输出"];
  }

  // ---------------- 6. 监督/安全 ----------------
  subgraph cluster_sup {
    label="⑥ 监督与安全"; color="#b71c1c"; style="rounded"; fontsize=14;
    sup [label="supervisor\narm/takeoff/mode/LAND（class-76）\n高度门 · geofence · 估计器断流/质量\nplan 静默 · truth-FCU 不一致 → ABORT/emergency", fillcolor="#ffebee"];
  }

  // ---------------- 7. 记录与评测 ----------------
  subgraph cluster_rec {
    label="⑦ 记录 → 评测 → 出图 → 质量门（每趟自动）"; color="#2e7d32"; style="rounded"; fontsize=14;
    rec [label="recorder\nsetpoints.csv · wire.csv · nav.csv\nlio.csv · scans.csv · tap.csv\nrosbag2 → derived/traj.csv.cmd.csv", fillcolor="#e8f5e9"];
    accept [label="accept.py（15 行）\nH0–H6 飞行有效性\nW0–W6 任务/跟踪/碰撞", fillcolor="#e8f5e9"];
    quality [label="quality_rows\nQ1 中段 stall · Q2 机身净空\nQ3 跟踪 · Q4 角点 · P1 规划-执行偏差+尖峰", fillcolor="#e8f5e9"];
    figs [label="出图\n topdown 整趟/分圈 · xyz-t · 速度 2-范数\n角点 zoom · clearance · P1 4 联图", fillcolor="#e8f5e9"];
    gate [label="质量门\nH6 clean（lidar 不饿死）· W1b 13/13\nP1 无 >1 m 尖峰 · Q 行 · ≥4 seed 地图\n速度阶梯 W2 4/6/8 m/s（大世界）", fillcolor="#c8e6c9", penwidth=2];
    offline [label="离线 replay 原型（新）\n用录制 CSV 跑 Route+Follower\n先对比 44b/94a，再飞", fillcolor="#e3f2fd"];
  }

  // ---------------- 数据流 ----------------
  sitl -> lidarsim [label="位姿/物理"];
  lidarsim -> lio [label="scan + IMU"];
  lio -> rogmap [label="点云 + 位姿"];
  lio -> route   [style=dashed, label="当前位姿/速度（估计）"];
  lio -> navgate [label="ODOMETRY"];

  route -> super [label="goals（穿过多角点）"];
  super -> smooth [label="路径 / 轨迹"];
  smooth -> follow [label="平滑路径"];
  follow -> vsmooth [label="v_cmd"];
  vsmooth -> shaper [label="限幅后 PVA"];
  shaper -> brg [label="#84 setpoint 50 Hz"];

  navgate -> brg [label="接受的外部导航"];
  brg -> ekf [label="ODOMETRY→ext-nav"];
  ekf -> ctl [label="状态估计"];
  ctl -> sitl [label="电机/舵面", style=bold];
  brg -> route [style=dashed, label="FCU 状态/模式"];

  sup -> brg [label="class-76 指令", color="#b71c1c"];
  sup -> route [label="ABORT/emergency", color="#b71c1c", style=dashed];
  navgate -> sup [label="断流/质量告警", color="#b71c1c", style=dashed];

  sitl -> tapd [label="真值"];
  tapd -> rec;
  lidarsim -> rec [label="scans"];
  lio -> rec;
  brg -> rec [label="setpoints / wire / nav"];
  shaper -> rec [style=dashed, label="/plan/cmd"];

  rec -> accept -> gate [label="15 行"];
  rec -> quality -> gate [label="Q/P 行"];
  accept -> figs; quality -> figs;
  rec -> offline [style=dashed, label="回放"];
  offline -> follow [style=dashed, color="#1565c0", label="验证后再上机"];

  // 图例
  subgraph cluster_legend {
    label="图例"; color="#999999"; style="rounded"; fontsize=12;
    lg1 [label="现有保留", fillcolor="#ffffff"];
    lg2 [label="设计新增/替换", fillcolor="#e3f2fd"];
    lg3 [label="记录/评测", fillcolor="#e8f5e9"];
    lg4 [label="安全/监督", fillcolor="#ffebee"];
  }
}
